{
  "manifest_version": 3,
  "name": "Uni-CLI Browser Control",
  "version": "1.0.0",
  "description": "Controls explicitly allocated or claimed Chrome tabs through an authenticated native host.",
  "key": "",
  "permissions": [
    "debugger",
    "downloads",
    "scripting",
    "tabs",
    "cookies",
    "activeTab",
    "alarms",
    "nativeMessaging",
    "storage",
    "windows"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "icons": {}
}
